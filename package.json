{
    "name": "mysql-workspace",
    "version": "0.0.0",
    "private": true,
    "description": "Workspace for the MySQL classic-protocol product",
    "license": "MPL-2.0",
    "type": "module",
    "scripts": {
        "check": "cargo check --manifest-path projects/mysql.rs/Cargo.toml --workspace --all-targets",
        "build:napi": "node scripts/build-napi.mjs",
        "build:ts": "tsc -p projects/mysql.ts/packages/mysql/tsconfig.json",
        "build:wasm": "node scripts/build-wasm.mjs",
        "check:wasm": "node scripts/check-wasm-package.mjs",
        "fmt": "cargo fmt --manifest-path projects/mysql.rs/Cargo.toml --all",
        "fmt:check": "cargo fmt --manifest-path projects/mysql.rs/Cargo.toml --all --check",
        "test:rust": "cargo test --manifest-path projects/mysql.rs/Cargo.toml --workspace",
        "typecheck": "tsc --noEmit"
    },
    "engines": {
        "node": ">=24.0.0"
    },
    "packageManager": "pnpm@10.18.3",
    "devDependencies": {
        "@doki-land/nifty": "^0.1.10",
        "@types/node": "24.10.1",
        "typescript": "5.9.3"
    }
}

